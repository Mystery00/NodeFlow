<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 普通设置与标签缓存保持不参与云备份；安全存储及旧版凭据文件一并排除。 -->
        <exclude domain="file" path="datastore/nodeflow_preferences.preferences_pb" />
        <exclude domain="sharedpref" path="nodeflow_secure_storage.xml" />
        <exclude domain="sharedpref" path="nodeflow_v2ex_cookies.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- 普通设置与标签缓存保持不参与设备迁移；安全存储及旧版凭据文件一并排除。 -->
        <exclude domain="file" path="datastore/nodeflow_preferences.preferences_pb" />
        <exclude domain="sharedpref" path="nodeflow_secure_storage.xml" />
        <exclude domain="sharedpref" path="nodeflow_v2ex_cookies.xml" />
    </device-transfer>
</data-extraction-rules>
