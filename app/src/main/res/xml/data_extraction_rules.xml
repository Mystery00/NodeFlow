<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 登录态包含 Token 和 Cookie，不参与系统云备份。 -->
        <exclude domain="file" path="datastore/nodeflow_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- 登录态包含 Token 和 Cookie，不参与设备迁移。 -->
        <exclude domain="file" path="datastore/nodeflow_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
